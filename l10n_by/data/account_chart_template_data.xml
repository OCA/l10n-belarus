<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Chart Template for Belarus -->
        <record id="by_chart_template" model="account.chart.template">
            <field name="name">Belarus - Chart of Accounts</field>
            <field name="country_id" ref="base.by"/>
            <field name="code_digits">4</field>
            <field name="bank_account_code_prefix">5110</field>
            <field name="cash_account_code_prefix">5010</field>
            <field name="transfer_account_code_prefix">5700</field>
            <field name="currency_id" ref="base.BYN"/>
        </record>
    </data>
</odoo>
