<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- VAT Taxes for Belarus -->

        <!-- VAT 20% (Standard Rate) -->
        <record id="sale_vat_20" model="account.tax.template">
            <field name="chart_template_id" ref="by_chart_template"/>
            <field name="name">VAT 20% (Sales)</field>
            <field name="description">VAT 20%</field>
            <field name="amount">20.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_vat_20"/>
            <field name="invoice_repartition_line_ids" eval="[
                Command.create({'repartition_type': 'base', 'factor_percent': 100.0}),
                Command.create({'repartition_type': 'tax', 'factor_percent': 100.0, 'account_id': ref('by_acc_6820')}),
            ]"/>
            <field name="refund_repartition_line_ids" eval="[
                Command.create({'repartition_type': 'base', 'factor_percent': 100.0}),
                Command.create({'repartition_type': 'tax', 'factor_percent': 100.0, 'account_id': ref('by_acc_6820')}),
            ]"/>
        </record>

